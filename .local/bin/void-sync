#!/usr/bin/env bash

DOTFILES_DIR="${HOME}/.dotfiles"

mkdir -p "$DOTFILES_DIR"

ls /var/service/ > "$DOTFILES_DIR/services.txt" 2>/dev/null

# Save explicitly installed packages
xpkg -m > "$DOTFILES_DIR/packages.txt"

echo "Saved:"
echo "  Services -> $DOTFILES_DIR/services.txt"
echo "  Packages -> $DOTFILES_DIR/packages.txt"
